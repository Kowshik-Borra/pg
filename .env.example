# PG Connect Environment Configuration Template
FLASK_APP=backend/run.py
FLASK_ENV=development
SECRET_KEY=pg-connect-super-secret-key-prod-2026
JWT_SECRET_KEY=pg-connect-jwt-token-secret-key-2026
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# MySQL Database Configuration
# Default connection format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pg_connect_db
# For lightweight development or when MySQL service is offline:
# DATABASE_URL=sqlite:///pg_connect.db

# Server and CORS
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500

# File Uploads
MAX_CONTENT_LENGTH=16777216
