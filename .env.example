# PG Connect Environment Configuration Template
FLASK_APP=backend/run.py
FLASK_ENV=development
SECRET_KEY=your-production-secret-key-change-this
JWT_SECRET_KEY=your-jwt-token-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# MySQL 8.0 Database Configuration (PyMySQL driver)
# Connection format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pg_connect_db
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=pg_connect_db

# Server and CORS
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# File Uploads (Bytes: default 16MB)
MAX_CONTENT_LENGTH=16777216
